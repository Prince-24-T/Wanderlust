<%- layout("./layout/boilerplate")-%>

<style>
  #filters{
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center; /* center on smaller screens */
    gap: 1rem; /* spacing between filters */
  }

  .filter{
    text-align: center;
    margin-top: 1rem;
    opacity: 0.7;
    flex: 0 1 100px; /* flexible width for responsiveness */
  }

  .filter:hover{
    opacity: 1;
    cursor: pointer;
  }

  .texs-info{
    display: none;
  }

  .text-toggle{
    margin: 1rem auto 1rem 0;
    border: 1px solid black;
    border-radius: 0.6rem;
    padding: 0.4rem 1rem;
    height: auto;
    max-width: 300px;
  }

  .listing-card img {
    object-fit: cover;
    width: 100%;
  }

  .listing-link {
    text-decoration: none;
    color: inherit;
  }
</style>

<!-- Filters Section -->
<div id="filters">
  <div class="filter">
    <div><i class="fa-solid fa-fire"></i></div>
    <p>Trending</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-bed"></i></div>
    <p>Rooms</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-fire"></i></div>
    <p>Iconic Cities</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-mountain-city"></i></div>
    <p>Mountain-city</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-mountain-sun"></i></div>
    <p>Mountain</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-person-swimming"></i></div>
    <p>Amazing Pools</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-umbrella-beach"></i></div>
    <p>Beach</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-sailboat"></i></div>
    <p>Boats</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-water"></i></div>
    <p>Lake</p>
  </div>

  <div class="text-toggle">
    <div class="form-check form-switch">
      <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
      <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
    </div>
  </div>
</div>

<!-- Listings Section -->
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4 mt-3">
  <% for(let listing of allListing){ %>
    <div class="col">
      <a href="/listings/<%=listing.id%>" class="listing-link">
        <div class="card listing-card h-100">
          <img src="<%=listing.image.url%>" class="card-img-top img-fluid" alt="listingimage" style="height: 20rem;">
          <div class="card-body">
            <p class="card-text">
              <b><%=listing.title%></b><br>
              &#8377; <%=listing.price%>/night
              <i class="texs-info"> &nbsp; +18% GST</i>
            </p>
          </div>
        </div>
      </a>
    </div>
  <% } %>
</div>

<script>
  let textSwitch = document.getElementById("switchCheckDefault");
  textSwitch.addEventListener("click", () => {
    let texsInfo = document.getElementsByClassName("texs-info");
    for(let info of texsInfo){
      info.style.display = (info.style.display !== "inline") ? "inline" : "none";
    }
  });
</script>
